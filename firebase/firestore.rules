rules_version = '2';

// S03 · Roles ESTUDIANTE / STAFF / ADMIN · S05 · Auditoría append-only.
// El campo `role` de users/{uid} solo lo cambia un ADMIN, y nadie cambia su propio rol.
// Se despliegan cuando exista el proyecto de Firebase (S02): `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && roleOf(request.auth.uid) == 'ADMIN';
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      // Cada quien lee su cuenta; el admin lee todas (panel de roles).
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Al primer ingreso la cuenta se crea siempre como ESTUDIANTE: nadie se registra como staff.
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'ESTUDIANTE';

      // El dueño puede editar sus datos, pero no su rol.
      allow update: if signedIn() && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      // El admin solo cambia el rol de OTRAS cuentas, entre ESTUDIANTE y STAFF, y nunca el de otro admin.
      allow update: if isAdmin() && request.auth.uid != uid
                    && onlyChanges(['role'])
                    && resource.data.role != 'ADMIN'
                    && request.resource.data.role in ['ESTUDIANTE', 'STAFF'];

      allow delete: if false;
    }

    function isStaff() {
      return signedIn() && roleOf(request.auth.uid) in ['STAFF', 'ADMIN'];
    }

    // S05 · Auditoría append-only: se agrega, nunca se cambia ni se borra (ni siquiera un admin).
    match /audit_logs/{logId} {
      // Solo el staff la consulta (visor de auditoría).
      allow read: if isStaff();

      // Cada quien registra SUS acciones: el actor es quien está autenticado y la hora la pone el servidor.
      allow create: if signedIn()
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.at == request.time
                    && request.resource.data.keys().hasOnly(['action', 'actorId', 'targetId', 'detail', 'at']);

      allow update, delete: if false;
    }

    function isUcb() {
      return signedIn() && request.auth.token.email.matches('.*@ucb[.]edu[.]bo$');
    }

    // L06 · Reportes de pérdida: cada estudiante ve y escribe los suyos; el staff ve todos (matching, reclamos)
    // y actualiza su estado. El dueño de un reporte no se cambia nunca. No se borran (cambian de estado).
    match /lost_reports/{reportId} {
      allow read: if isUcb() && (resource.data.ownerId == request.auth.uid || isStaff());
      allow create: if isUcb() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isUcb() && request.resource.data.ownerId == resource.data.ownerId
                    && (resource.data.ownerId == request.auth.uid || isStaff());
      allow delete: if false;
    }

    // L06 · Objetos encontrados: cualquier cuenta UCB los lee (catálogo y matching; las respuestas esperadas NO
    // están en este documento). Solo el staff los registra y edita. El estudiante solo puede marcarlo como
    // RECLAMADO al reclamarlo, o devolverlo a DISPONIBLE si su reclamo se rechaza (V01/V02).
    match /found_items/{itemId} {
      allow read: if isUcb();
      allow create: if isStaff() && request.resource.data.registeredBy == request.auth.uid;
      allow update: if isStaff() && request.resource.data.registeredBy == resource.data.registeredBy;
      allow update: if isUcb() && onlyChanges(['status'])
                    && ((resource.data.status == 'DISPONIBLE' && request.resource.data.status == 'RECLAMADO')
                        || (resource.data.status == 'RECLAMADO' && request.resource.data.status == 'DISPONIBLE'));
      allow delete: if false;
    }
  }
}
