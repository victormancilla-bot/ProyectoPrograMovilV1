# Normaliza finales de línea: LF en el repo, el sistema decide al hacer checkout.
* text=auto

# Scripts que necesitan un final de línea fijo
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binarios
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
